# Loaded by `vite build --mode pages`. Selects the serverless backend.
VITE_BACKEND=local

# Cloud sync. Both are public values baked into the bundle, which is expected:
# the client id is not a secret and the Worker URL is called from the browser.
# Leave them blank and the account UI does not render at all.
VITE_SYNC_API=https://lightblueprep-sync.kristpaulm.workers.dev
VITE_GOOGLE_CLIENT_ID=935646101294-kc3gqoo8a85pf5jl9ok2712ccijtquc0.apps.googleusercontent.com

# Donation page (Ko-fi, Buy Me a Coffee...). Blank hides the Support link.
VITE_DONATE_URL=
